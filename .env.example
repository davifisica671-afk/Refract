# =============================================================================
# Refract — exemplo de configuração local (.env)
# =============================================================================
# COMO USAR:
#   1. Copie para `.env` (nunca commite o `.env` — já está no .gitignore).
#   2. Preencha SOMENTE o que você usa. Placeholders propositalmente inválidos:
#      o lemonsqueezy-server recusa subir com placeholders em produção.
#   3. Chaves de API do app desktop podem ir aqui (dev) ou na tela de
#      Configurações (recomendado — vai para o keychain do SO via safeStorage).
#
# SE UMA CHAVE VAZAR (commit, print, backup, sync): revogue no provedor e
# gere outra. Ver docs/SECRETS.md (rotação passo a passo).
# =============================================================================

# ── OAuth Google (calendário) ──────────────────────────────────────────────
# Client ID não é segredo; o secret NUNCA vai no app — fica no refract-api.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET só existe fora deste repo (backend). Não coloque aqui.

# ── Provedores LLM (dev local; prefira a tela de Configurações) ────────────
GROQ_API_KEY=gsk_your_groq_key_here
OPENAI_API_KEY=sk-proj-your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
CLAUDE_API_KEY=your_claude_api_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# ── Speech (opcional — basta um) ───────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here
AZURE_SPEECH_KEY=your_azure_key_here
AZURE_SPEECH_REGION=eastus
IBM_WATSON_API_KEY=your_ibm_key_here
IBM_WATSON_REGION=us-south

# ── Google Cloud Speech (service account) ──────────────────────────────────
# NUNCA guarde o JSON dentro do repo. Caminho absoluto fora do workspace:
#   Windows: C:\Users\<voce>\.secrets\gcp-stt.json
#   macOS/Linux: ~/.secrets/gcp-stt.json
# O arquivo atual `tonal-history-*.json` na raiz é gitignorado mas mora no
# lugar errado — mova e atualize o caminho abaixo.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\<voce>\.secrets\gcp-stt.json

# ── IA local ───────────────────────────────────────────────────────────────
USE_OLLAMA=true
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=gemini-3-flash-preview

# ── Hindsight (memória longa, OPCIONAL, default desligado) ─────────────────
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_TIMEOUT_MS=800
NATIVELY_MEMORY_PROVIDER=disabled
HINDSIGHT_RETAIN_ASYNC=true

# ── Backend próprio / miscelânea ───────────────────────────────────────────
REFRACT_API_URL=https://api.refract.software
VITE_POSTHOG_KEY=
SENTRY_DSN=

# ── lemonsqueezy-server (NÃO vai neste .env em prod — vai em `fly secrets`;
#     aqui, só para dev local do servidor. Placeholders = servidor recusa.) ─
# LEMONSQUEEZY_API_KEY=your_ls_api_key_here
# LEMONSQUEEZY_STORE_ID=your_store_id_here
# LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here
# LEMONSQUEEZY_VARIANT_MONTHLY=your_variant_id_here
# LEMONSQUEEZY_VARIANT_YEARLY=your_variant_id_here
# LEMONSQUEEZY_VARIANT_LIFETIME=your_variant_id_here
# LICENSE_SIGNING_KEY_PATH=C:\Users\<voce>\.refract\license-signing-key.pem
# LS_ALLOW_LEGACY_NO_HWID=0
# LS_TRUST_PROXY=0
